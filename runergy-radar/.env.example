# Runergy Radar settings. On Vercel these go in Settings → Environment Variables (then redeploy).
# For local use, export them in your shell. Never commit real values.

# --- Required online ---
RADAR_PASSWORD=            # the password you sign in to the dashboard with
CRON_SECRET=               # any long random text; the same value goes in GitHub's CRON_SECRET secret
DATABASE_URL=              # added automatically when you connect a Neon database in Vercel

# --- Finding and drafting ---
ANTHROPIC_API_KEY=         # console.anthropic.com → API Keys
SERPAPI_API_KEY=           # serpapi.com → Dashboard → Your Private API Key
# RADAR_SERPAPI_KEY=       # optional: a separate SerpApi key just for Radar
# RADAR_MODEL=claude-opus-5-5

# --- Alerts (either or both) ---
TELEGRAM_BOT_TOKEN=        # from @BotFather
TELEGRAM_CHAT_ID=          # the chat id from https://api.telegram.org/bot<token>/getUpdates
SMTP_USERNAME=             # e.g. you@gmail.com
SMTP_PASSWORD=             # Gmail: an App Password
EMAIL_TO=                  # where alerts go (comma-separate several)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_FROM=

# --- Optional sources ---
# BLUESKY_HANDLE=          # only if the Sources page says Bluesky wants a sign-in
# BLUESKY_APP_PASSWORD=
# THREADS_ACCESS_TOKEN=
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_TOKEN=

# --- Optional ---
# RADAR_URL=               # the dashboard's address; learned automatically if left out
